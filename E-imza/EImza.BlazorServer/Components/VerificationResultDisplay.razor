@using EImza.BlazorServer.Models

@if (!string.IsNullOrEmpty(Result?.ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        <MudText Typo="Typo.body1">
            <strong>Verification Failed</strong>
        </MudText>
        <MudText Typo="Typo.body2">@Result.ErrorMessage</MudText>
    </MudAlert>
}
else if (Result != null)
{
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h6">Verification Result</MudText>
        </MudCardHeader>
        <MudCardContent>
            @if (Result.IsValid)
            {
                <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Filled.CheckCircle" Class="mb-4">
                    <MudText Typo="Typo.body1">
                        <strong>Document is Authentic!</strong>
                    </MudText>
                    <MudText Typo="Typo.body2">
                        The digital signature is valid and the document has not been tampered with.
                    </MudText>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Icon="@Icons.Material.Filled.Cancel" Class="mb-4">
                    <MudText Typo="Typo.body1">
                        <strong>Invalid Signature or Tampered Document</strong>
                    </MudText>
                    <MudText Typo="Typo.body2">
                        The digital signature is invalid or the document has been modified since signing.
                    </MudText>
                </MudAlert>
            }

            @if (Result.Signatures.Count > 0)
            {
                <MudText Typo="Typo.subtitle1" Class="mb-3">Signatures Found</MudText>

                @foreach (var sig in Result.Signatures)
                {
                    <MudPaper Class="pa-4 mb-3" Elevation="2">
                        <MudText Typo="Typo.body2">
                            <strong>Signer:</strong> @sig.Signer<br />
                            <strong>Signing Time:</strong> @sig.SigningTime:yyyy-MM-dd HH:mm:ss<br />
                            <strong>Hash Algorithm:</strong> @sig.HashAlgorithm<br />
                            <strong>Signature Valid:</strong>
                            @if (sig.IsSignatureValid)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Yes</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">No</MudChip>
                            }
                            <br />
                            <strong>Document Modified:</strong>
                            @if (sig.IsDocumentModified)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Yes</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">No</MudChip>
                            }
                        </MudText>
                    </MudPaper>
                }
            }

            @if (Result.Certificate != null)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1" Class="mb-3">Certificate Information</MudText>
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.body2">
                        <strong>Subject:</strong> @Result.Certificate.Subject<br />
                        <strong>Issuer:</strong> @Result.Certificate.Issuer<br />
                        <strong>Valid From:</strong> @Result.Certificate.ValidFrom:yyyy-MM-dd<br />
                        <strong>Valid To:</strong> @Result.Certificate.ValidTo:yyyy-MM-dd<br />
                        @if (Result.Certificate.IsAutoGenerated)
                        {
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="mt-2">Auto-generated</MudChip>
                        }
                    </MudText>
                </MudPaper>
            }
        </MudCardContent>
    </MudCard>
}
else if (IsVerifying)
{
    <MudCard>
        <MudCardContent Class="d-flex align-center justify-center" Style="min-height: 200px;">
            <div class="text-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" Class="mt-4">
                    Verifying document...
                </MudText>
            </div>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter]
    public VerificationResult? Result { get; set; }

    [Parameter]
    public bool IsVerifying { get; set; }
}
