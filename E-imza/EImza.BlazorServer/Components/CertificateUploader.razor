@using EImza.BlazorServer.Models
@using EImza.BlazorServer.Services
@using Microsoft.AspNetCore.Components.Web
@inject CertificateService CertificateService

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h6">Certificate Configuration</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudRadioGroup T="bool" @bind-SelectedOption="_selectedOption">
            <MudRadio T="bool" Option="true" Color="Color.Primary">Upload my certificate</MudRadio>
            <MudRadio T="bool" Option="false" Color="Color.Primary">Auto-generate certificate</MudRadio>
        </MudRadioGroup>

        @if (_selectedOption == true)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2" Class="mb-4">
                Upload your .pfx or .p12 certificate file. The certificate must have a private key.
            </MudText>

            <MudFileInput T="IBrowserFile" FileChanged="OnCertificateFileChanged"
                          Accept=".pfx,.p12" Label="Certificate File" Class="mb-4" />

            <MudTextField T="string" @bind-Value="_password" Label="Password"
                          InputType="InputType.Password" AdornmentIcon="@Icons.Material.Filled.Lock"
                          Adornment="Adornment.End" Variant="Variant.Outlined" Class="mb-4" />

            <MudButton OnClick="UploadCertificate" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="_certificateFile == null || string.IsNullOrEmpty(_password)" StartIcon="@Icons.Material.Filled.Upload">
                Upload Certificate
            </MudButton>
        }
        else
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2" Class="mb-4">
                A self-signed certificate will be automatically generated for signing.
                This is useful for testing and demonstration purposes.
            </MudText>

            <MudAlert Severity="Severity.Info" Class="mb-4">
                <MudText Typo="Typo.body2">
                    Auto-generated certificates are for testing only. For production use,
                    please upload a certificate from a trusted Certificate Authority.
                </MudText>
            </MudAlert>

            <MudButton OnClick="GenerateCertificate" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoFixHigh">
                Auto-generate Certificate
            </MudButton>
        }

        @if (_certificate != null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Current Certificate</MudText>
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.body2">
                    <strong>Subject:</strong> @_certificate.Subject<br />
                    <strong>Issuer:</strong> @_certificate.Issuer<br />
                    <strong>Valid From:</strong> @_certificate.ValidFrom:yyyy-MM-dd<br />
                    <strong>Valid To:</strong> @_certificate.ValidTo:yyyy-MM-dd<br />
                    <strong>Key Size:</strong> @_certificate.KeySizeBits bits<br />
                    @if (_certificate.IsAutoGenerated)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="mt-2">Auto-generated</MudChip>
                    }
                </MudText>
                <MudButton OnClick="RemoveCertificate" Variant="Variant.Text" Color="Color.Error"
                           Size="Size.Small" Class="mt-3" StartIcon="@Icons.Material.Filled.Delete">
                    Remove Certificate
                </MudButton>
            </MudPaper>
        }

        @if (_errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    private bool? _selectedOption = false;
    private IBrowserFile? _certificateFile;
    private string _password = string.Empty;
    private CertificateInfo? _certificate;
    private string? _errorMessage;

    [Parameter]
    public CertificateInfo? Certificate
    {
        get => _certificate;
        set
        {
            _certificate = value;
            if (value != null)
            {
                _selectedOption = value.IsAutoGenerated ? false : true;
            }
        }
    }

    [Parameter]
    public EventCallback<CertificateInfo> CertificateChanged { get; set; }

    [Parameter]
    public bool AllowAutoGenerate { get; set; } = true;

    private void OnCertificateFileChanged(IBrowserFile file)
    {
        _certificateFile = file;
        _errorMessage = null;
    }

    private async Task UploadCertificate()
    {
        if (_certificateFile == null || string.IsNullOrEmpty(_password))
        {
            _errorMessage = "Please select a certificate file and enter the password.";
            return;
        }

        try
        {
            await using var stream = _certificateFile.OpenReadStream();
            _certificate = await CertificateService.UploadCertificateAsync(stream, _password);
            _errorMessage = null;

            await CertificateChanged.InvokeAsync(_certificate);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load certificate: {ex.Message}";
        }
    }

    private void GenerateCertificate()
    {
        try
        {
            _certificate = CertificateService.GenerateCertificate("CN=EImzaAutoGenerated");
            _errorMessage = null;

            CertificateChanged.InvokeAsync(_certificate);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to generate certificate: {ex.Message}";
        }
    }

    private void RemoveCertificate()
    {
        _certificate = null;
        CertificateChanged.InvokeAsync(null!);
    }
}
