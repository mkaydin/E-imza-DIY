@using EImza.BlazorServer.Shared
@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="2">
        <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-4" />
        <MudText Typo="Typo.h6">E-İmza</MudText>
        <MudSpacer />
        <MudTooltip Text="Settings">
            <MudIconButton Icon="@Icons.Material.Filled.Settings" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer ClipMode="DrawerClipMode.Always" Open="true" Elevation="1" Variant="DrawerVariant.Persistent">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
